{
  "srcDirs": [
    "./projects/libraries/aether-router/src/lib"
  ],
  "testDirs": [
    "./projects/libraries/aether-router/src/tests"
  ],
  "exclude": [
    "**/node_modules/**"
  ],
  "preserveOutputs": false,
  "outDir": "dist/.vite-jasmine-build",
  "browser": "chrome",
  "headless": false,
  "coverage": false,
  "port": 8888,
  "viteBuildOptions": {
    "target": "es2022",
    "sourcemap": true,
    "minify": false,
    "preserveModules": false,
    "preserveModulesRoot": "."
  },
  "viteConfig": {
    "resolve": {
      "alias": {
        "aether-router": "./dist/aether-router/fesm2022/aether-router.mjs"
      }
    }
  },
  "jasmineConfig": {
    "env": {
      "stopSpecOnExpectationFailure": false,
      "random": true,
      "seed": 0,
      "timeout": 120000
    }
  },
  "htmlOptions": {
    "title": "Jasmine Test Runner",
    "preludeModules": [
      "@angular/compiler"
    ]
  },
  "suppressConsoleLogs": false
}
